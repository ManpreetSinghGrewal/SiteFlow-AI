# MongoDB (server-side only — set in Vercel / Render dashboard)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.wgwbmjl.mongodb.net/siteflow?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-secret
PORT=3001

# Google AI — required for website generation chat
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Brevo (Sendinblue) Transactional Emails — Welcome & Password Reset
# Get key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@siteflowai.com
BREVO_SENDER_NAME=SiteFlow AI

# Optional: only needed if frontend and API are on different domains
# VITE_API_URL=https://your-api.onrender.com
